<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Authors>niceday_zhu</Authors>
    <Product>CS2 鸡桌宠</Product>
    <Description>使用本机 CS2 资源的实时 3D 桌面宠物</Description>
    <Copyright>Copyright (c) 2026 niceday_zhu</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\chick.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <InternalsVisibleTo Include="ChickenDesktopPet3D.RendererRegression" />
    <PackageReference Include="ValveResourceFormat.Renderer" Version="20.0.6980" />
    <PackageReference Include="OpenTK.Windowing.Desktop" Version="4.9.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\industrial_sunset_puresky.vtex_c" LogicalName="ChickLighting" />
    <EmbeddedResource Include="LICENSE-ValveResourceFormat.txt" LogicalName="ValveResourceFormatLicense" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="ProjectLicense" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.md" LogicalName="ThirdPartyNotices" />
  </ItemGroup>
</Project>
